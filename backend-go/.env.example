APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
CORS_ALLOWED_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
DATABASE_URL=postgresql://course_ai:course_ai_password@localhost:5433/course_ai?sslmode=disable
DB_HOST=localhost
DB_PORT=5433
DB_NAME=course_ai
DB_USER=course_ai
DB_PASSWORD=course_ai_password
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_IDLE_TIME=30m
DB_MAX_CONN_LIFETIME=1h
DB_HEALTH_CHECK_PERIOD=1m
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://course_ai:course_ai_password@localhost:5433/course_ai?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
PROMPTS_DIR=./prompts

JWT_SECRET=change_me_in_local_env
JWT_TOKEN_TTL=24h
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_MODEL="gpt-5.6-luna"

GENERATION_WORKER_ENABLED=true
GENERATION_WORKER_CONCURRENCY=1
GENERATION_WORKER_ID_PREFIX=course-ai
GENERATION_JOB_POLL_INTERVAL=1s
GENERATION_JOB_LEASE_DURATION=5m
GENERATION_JOB_HEARTBEAT_INTERVAL=1m
GENERATION_JOB_DEFAULT_TIMEOUT=30m
GENERATION_JOB_SHUTDOWN_TIMEOUT=20s
GENERATION_JOB_CLEANUP_TIMEOUT=5s
GENERATION_JOB_REAPER_INTERVAL=30s
GENERATION_JOB_MAX_ATTEMPTS=3
GENERATION_JOB_RETRY_BASE_DELAY=5s
GENERATION_JOB_RETRY_MAX_DELAY=2m
GENERATION_JOB_RETRY_JITTER_FRACTION=0.2
