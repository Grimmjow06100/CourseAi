# Copy to .env.production.local for a local production build, or configure
# these variables in Vercel's Production environment. Empty values fail the build.
# HTTPS backend origin, without /api (the client already includes that prefix).
VITE_API_BASE_URL=
# Real publishable key from the Clerk production instance (pk_live_...).
# Never put CLERK_SECRET_KEY or OPENAI_API_KEY in the frontend.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_E2E_MODE=false
